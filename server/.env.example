NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aether-news
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# Optional — enables Cloudinary uploads & media library
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=delta-news
